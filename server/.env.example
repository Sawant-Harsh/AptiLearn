# ---------- Server ----------
PORT=5000
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:3000

# ---------- Database ----------
# Leave MONGODB_URI empty to use a local JSON file (server/data/db.json) - zero setup.
# For real MongoDB (local or Atlas):  MONGODB_URI=mongodb://127.0.0.1:27017   (or mongodb+srv://...)
MONGODB_URI=
MONGODB_DB=aptilearn

# ---------- Admin (the ONLY admin account) ----------
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin123

# ---------- Real AI (AptiBot + AI question builder) ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---------- Google sign-in (account chooser) ----------
# Create an OAuth "Web application" client at https://console.cloud.google.com/apis/credentials
# Authorised JavaScript origins: http://localhost:3000 (and your deployed URL)
GOOGLE_CLIENT_ID=

# ---------- YouTube lesson videos ----------
# YouTube Data API v3 key (free). Finds a real, embeddable video for every lesson/topic.
YOUTUBE_API_KEY=
